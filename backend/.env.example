# Car Damage Detection API Configuration

# ============================================
# Model Configuration
# ============================================

# Use mock model for testing (no real AI inference)
# Set to 'true' for testing without downloading AI model
# Set to 'false' to use real AI model
USE_MOCK_MODEL=false

# Model type: "yolo" or "huggingface"
MODEL_TYPE=huggingface

# Hugging Face model name (only used when MODEL_TYPE=huggingface)
# Options:
#   - beingamit99/car_damage_detection (car damage classification)
HUGGINGFACE_MODEL=beingamit99/car_damage_detection

# Path to YOLO model weights (only used when MODEL_TYPE=yolo)
# Options:
#   - yolov8n.pt (auto-download, general purpose, 6MB)
#   - yolov8s.pt (auto-download, better accuracy, 22MB)
#   - models/car-damage-yolov8.pt (custom trained model)
MODEL_PATH=yolov8n.pt

# Confidence threshold for detections (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.25

# ============================================
# Storage Configuration
# ============================================

# Use local storage instead of S3 (for development)
USE_LOCAL_STORAGE=true

# S3 bucket name (only used when USE_LOCAL_STORAGE=false)
S3_BUCKET_NAME=car-damage-detection-bucket

# ============================================
# File Upload Configuration
# ============================================

# Maximum file size in megabytes
MAX_FILE_SIZE_MB=10

# ============================================
# CORS Configuration
# ============================================

# Allowed origins for CORS (comma-separated)
# Default includes common development ports
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://my-damage-detector-app.com
